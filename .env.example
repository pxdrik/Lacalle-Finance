# Copie este arquivo para ".env" e preencha com os dados do SEU projeto
# Supabase (painel do Supabase > Project Settings > API).
#
# IMPORTANTE: nunca coloque a "service_role key" aqui, nem no .env, nem em
# nenhum lugar do código do site. Só a "anon public key" (que é feita pra
# ficar exposta no navegador — a segurança de verdade vem do RLS, não de
# esconder essa chave).

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-key-aqui
